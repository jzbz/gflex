  {
    "name": "write voltage 32768 mV",
    "dir": "tx",
    "cmd": 18,
    "write": true,
    "payload": "8000",
    "frame": "04928000",
    "midi": "800000 900004 900902 900800 900000 a00000",
    "usbmidi": "08800000 09900004 09900902 09900800 09900000 0aa00000",
    "note": "Derived, not from §15: 0x8000 puts the high bit in a payload byte and produces two velocity-0 messages back to back. This is what the nibble split exists for -- neither emitted data byte ever exceeds 0x0F."
  },
